# Loaded whenever APP_ENV=testing (php artisan test, phpunit, --env=testing).
# Keeps the suite off the working database/database.sqlite. Safe to commit —
# no secrets here.

APP_ENV=testing
APP_KEY=base64:HXF2aWvIW4GCXduY+c5QuUfQkbzjV9X84nk50IUxJ4E=

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# API token for HTTP tests that do not override it themselves.
APPTRACKER_TOKEN=testing-token

# Never let a test reach the real vault. tracker:import tests pass explicit
# --applications / --queue paths instead.
APPTRACKER_VAULT_PATH=
APPTRACKER_MOC_APPLICATIONS=
APPTRACKER_MOC_JOB_SORT_QUEUE=
